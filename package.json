{
  "name": "rekhta-desktop",
  "version": "1.0.2",
  "description": "REKHTA Desktop Urdu & Graphic Design Editor - RK Solution",
  "main": "main.js",
  "author": "RK Solution",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "portable": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.rksolution.rekhta",
    "productName": "REKHTA",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "REKHTA"
    }
  }
}
